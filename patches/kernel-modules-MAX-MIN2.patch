From 94be3802a0ec5c6dea7ac473bd2e7bd5a3a425c6 Mon Sep 17 00:00:00 2001
From: chandu078 <chandudyavanapelli03@gmail.com>
Date: Wed, 8 Oct 2025 15:53:39 +0000
Subject: [PATCH] qcom: Drop redundant local MIN() and MAX() macros

It is now added globally in the kernel.
See: https://lore.kernel.org/all/20250930143824.503977053@linuxfoundation.org.

Change-Id: I77b422ffa19d707b8a0e4a302c2d69b0f26f08e9
Signed-off-by: GuidixX <guidixm@gmail.com>
---
 .../driver/variant/iris2/inc/hfi_buffer_iris2.h           | 8 --------
 1 file changed, 8 deletions(-)

diff --git a/qcom/opensource/video-driver/driver/variant/iris2/inc/hfi_buffer_iris2.h b/qcom/opensource/video-driver/driver/variant/iris2/inc/hfi_buffer_iris2.h
index 5be5f720f71..612d7422667 100644
--- a/qcom/opensource/video-driver/driver/variant/iris2/inc/hfi_buffer_iris2.h
+++ b/qcom/opensource/video-driver/driver/variant/iris2/inc/hfi_buffer_iris2.h
@@ -19,14 +19,6 @@ typedef s32     HFI_S32;
 typedef u64     HFI_U64;
 typedef HFI_U32 HFI_BOOL;
 
-#ifndef MIN
-#define  MIN(x, y) (((x) < (y)) ? (x) : (y))
-#endif
-
-#ifndef MAX
-#define  MAX(x, y) (((x) > (y)) ? (x) : (y))
-#endif
-
 #define HFI_ALIGNMENT_4096 (4096)
 
 #define BUF_SIZE_ALIGN_16 (16)
 