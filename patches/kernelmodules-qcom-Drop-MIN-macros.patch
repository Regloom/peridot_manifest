From 86cb72cbcffd88368586947dfd9221edff9be945 Mon Sep 17 00:00:00 2001
From: Egor Tokarev <egor.tokarev@outlook.com>
Date: Mon, 20 Oct 2025 07:42:31 +0200
Subject: [PATCH] qcom: Drop redundant local MIN() MAX() macros

It is now added globally in the kernel. See:
 https://lore.kernel.org/all/20250930143824.503977053@linuxfoundation.org.
---
 .../audio-kernel/asoc/codecs/fs19xx/fsm-dev.h          |  1 -
 .../asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h        |  1 -
 .../goodix_berlin_driver/goodix_ts_inspect.c           |  1 -
 qcom/opensource/touch-drivers/pt/pt_device_access.c    |  4 ----
 .../touch-drivers/synaptics_tcm/synaptics_tcm_core.h   | 10 ----------
 .../wlan/qca-wifi-host-cmn/utils/pktlog/linux_ac.c     |  4 ----
 6 files changed, 21 deletions(-)

diff --git a/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h b/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h
index 708184c9c5..d38a624e67 100644
--- a/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h
+++ b/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h
@@ -227,7 +227,6 @@ enum dev_id_index {

 #define FSM_DEV_MAX (4)
 #define FSM_ADDR_BASE (0x34)
-#define MIN(a, b) ((a) < (b) ? (a) : (b))
 #ifndef BIT
 #define BIT(nr) (1UL << (nr))
 #endif
diff --git a/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h b/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h
index 708184c9c5..d38a624e67 100644
--- a/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h
+++ b/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h
@@ -227,7 +227,6 @@ enum dev_id_index {

 #define FSM_DEV_MAX (4)
 #define FSM_ADDR_BASE (0x34)
-#define MIN(a, b) ((a) < (b) ? (a) : (b))
 #ifndef BIT
 #define BIT(nr) (1UL << (nr))
 #endif
diff --git a/qcom/opensource/touch-drivers/goodix_berlin_driver/goodix_ts_inspect.c b/qcom/opensource/touch-drivers/goodix_berlin_driver/goodix_ts_inspect.c
index 3dd2f4bcd4..7c9b5a3a3f 100644
--- a/qcom/opensource/touch-drivers/goodix_berlin_driver/goodix_ts_inspect.c
+++ b/qcom/opensource/touch-drivers/goodix_berlin_driver/goodix_ts_inspect.c
@@ -111,7 +111,6 @@


 #define ABS(val)                       ((val < 0)? -(val) : val)
-#define MAX(a, b)                      ((a > b)? a : b)

 static bool module_initialized;

diff --git a/qcom/opensource/touch-drivers/pt/pt_device_access.c b/qcom/opensource/touch-drivers/pt/pt_device_access.c
index 611483a06b..3eaf4d560f 100644
--- a/qcom/opensource/touch-drivers/pt/pt_device_access.c
+++ b/qcom/opensource/touch-drivers/pt/pt_device_access.c
@@ -200,10 +200,6 @@ struct heatmap_param {
 #endif
 #define ABS(x)                 (((x) < 0) ? -(x) : (x))

-#ifndef MIN
-#define MIN(a, b)  (((a) < (b)) ? (a) : (b))
-#endif
-
 #define PT_MAX_CONFIG_BYTES    256
 #define PT_TTHE_TUNER_GET_PANEL_DATA_FILE_NAME "get_panel_data"
 #define TTHE_TUNER_MAX_BUF     (PT_MAX_PRBUF_SIZE * 8)
diff --git a/qcom/opensource/touch-drivers/synaptics_tcm/synaptics_tcm_core.h b/qcom/opensource/touch-drivers/synaptics_tcm/synaptics_tcm_core.h
index b13a5c01fc..a377ac63d1 100644
--- a/qcom/opensource/touch-drivers/synaptics_tcm/synaptics_tcm_core.h
+++ b/qcom/opensource/touch-drivers/synaptics_tcm/synaptics_tcm_core.h
@@ -99,16 +99,6 @@
                } \
        } while (0)

-#define MAX(a, b) \
-       ({__typeof__(a) _a = (a); \
-       __typeof__(b) _b = (b); \
-       _a > _b ? _a : _b; })
-
-#define MIN(a, b) \
-       ({__typeof__(a) _a = (a); \
-       __typeof__(b) _b = (b); \
-       _a < _b ? _a : _b; })
-
 #define STR(x) #x

 #define CONCAT(a, b) a##b
diff --git a/qcom/opensource/wlan/qca-wifi-host-cmn/utils/pktlog/linux_ac.c b/qcom/opensource/wlan/qca-wifi-host-cmn/utils/pktlog/linux_ac.c
index c53b8397ba..1cc2cacd97 100644
--- a/qcom/opensource/wlan/qca-wifi-host-cmn/utils/pktlog/linux_ac.c
+++ b/qcom/opensource/wlan/qca-wifi-host-cmn/utils/pktlog/linux_ac.c
@@ -809,10 +809,6 @@ static int pktlog_release(struct inode *i, struct file *f)
        return errno;
 }

-#ifndef MIN
-#define MIN(a, b) (((a) < (b)) ? (a) : (b))
-#endif
-
 /**
  * pktlog_read_proc_entry() - This function is used to read data from the
  * proc entry into the readers buffer
--
2.34.1
