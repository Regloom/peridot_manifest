From eee8037362cc21d4d685fdec3cc0a3bc92d91357 Mon Sep 17 00:00:00 2001
From: Egor Tokarev <egor.tokarev@outlook.com>
Date: Mon, 20 Oct 2025 07:42:31 +0200
Subject: [PATCH] qcom: Drop redundant local MIN() macros for fs19xx

It is now added globally in the kernel. See:
 https://lore.kernel.org/all/20250930143824.503977053@linuxfoundation.org.
---
 qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h        | 1 -
 .../audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h     | 1 -
 2 files changed, 2 deletions(-)

diff --git a/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h b/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h
index 708184c9c5..d38a624e67 100644
--- a/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h
+++ b/qcom/opensource/audio-kernel/asoc/codecs/fs19xx/fsm-dev.h
@@ -227,7 +227,6 @@ enum dev_id_index {

 #define FSM_DEV_MAX (4)
 #define FSM_ADDR_BASE (0x34)
-#define MIN(a, b) ((a) < (b) ? (a) : (b))
 #ifndef BIT
 #define BIT(nr) (1UL << (nr))
 #endif
diff --git a/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h b/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h
index 708184c9c5..d38a624e67 100644
--- a/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h
+++ b/qcom/opensource/audio-kernel/asoc/codecs/pa_combine/inc/fs19xx/fsm-dev.h
@@ -227,7 +227,6 @@ enum dev_id_index {

 #define FSM_DEV_MAX (4)
 #define FSM_ADDR_BASE (0x34)
-#define MIN(a, b) ((a) < (b) ? (a) : (b))
 #ifndef BIT
 #define BIT(nr) (1UL << (nr))
 #endif
--
2.34.1
