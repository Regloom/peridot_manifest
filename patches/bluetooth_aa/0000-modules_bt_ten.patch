From 58e693c82c3b7d903a98fcbc568331b278c31af8 Mon Sep 17 00:00:00 2001
From: Weifan <weifan.zhang@mediatek.com>
Date: Fri, 1 Mar 2024 14:18:48 +0800
Subject: [PATCH 01/10] Fix BT noise issue during startup

[Description]
Bluetooth audio noise

[Root Cause]
For SBC codec, when PCM data isn't enough to encode,
it will be saved as residual data and fill it up next time.

However, there is a bug in the existing code that clears the buffer every time, result the residual data being cleared.

[Solution]
Only when there is no residual data can the buffer be cleared.

Bug: 335785333

Test Result: ok

CR-Id: DTV04109112
Change-Id: I67951187792eb12abf6cc8e975011cfaa2524658
Signed-off-by: Pranav Vashi <neobuddy89@gmail.com>
Signed-off-by: Pranav Temkar <pranavtemkar@gmail.com>
---
 system/stack/a2dp/a2dp_sbc_encoder.cc | 7 +++++--
 1 file changed, 5 insertions(+), 2 deletions(-)

diff --git a/system/stack/a2dp/a2dp_sbc_encoder.cc b/system/stack/a2dp/a2dp_sbc_encoder.cc
index f4b5817e88..0e5d1251c8 100644
--- a/system/stack/a2dp/a2dp_sbc_encoder.cc
+++ b/system/stack/a2dp/a2dp_sbc_encoder.cc
@@ -471,9 +471,12 @@ static void a2dp_sbc_encode_frames(uint8_t nb_frame) {
     a2dp_sbc_encoder_cb.stats.media_read_total_expected_packets++;
 
     do {
-      /* Fill allocated buffer with 0 */
-      memset(a2dp_sbc_encoder_cb.pcmBuffer, 0,
+      /* Fill allocated buffer with 0 when residue data is not existing*/
+      if (a2dp_sbc_encoder_cb.feeding_state.aa_feed_residue == 0) {
+        memset(a2dp_sbc_encoder_cb.pcmBuffer, 0,
              blocm_x_subband * p_encoder_params->s16NumOfChannels);
+      }
+
       //
       // Read the PCM data and encode it. If necessary, upsample the data.
       //
-- 
2.47.3


