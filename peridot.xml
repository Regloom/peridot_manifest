	<!--Keyboard-->
	<remove-project name="LineageOS/android_packages_inputmethods_LatinIME" />
	<project path="packages/inputmethods/LatinIME" name="VoltageOS/packages_inputmethods_LatinIME" groups="pdk-fs" remote="git-hub" revision="16" />
	
