<?xml version="1.0" encoding="UTF-8"?>
<manifest>
    <remote name="git-hub" fetch="https://github.com/" />
    <!-- Xiaomi-specific hardware -->
    <project path="hardware/xiaomi" name="peridot-dev/android_hardware_xiaomi" remote="git-hub" revision="lineage-23.0" />

	<!-- Device Tree -->
	<project path="device/xiaomi/peridot" name="peridot-dev/android_device_xiaomi_peridot" remote="git-hub" revision="lineage-23.0" />
	<project path="vendor/xiaomi/peridot" name="peridot-dev/proprietary_vendor_xiaomi_peridot" remote="git-hub" revision="lineage-23.0" />

	<!-- Kernel -->
	<project path="kernel/xiaomi/sm8635" name="Regloom/android_kernel_xiaomi_sm8635" remote="git-hub" revision="lineage-23.0-next"/>
	<project path="kernel/xiaomi/sm8635-modules" name="peridot-dev/android_kernel_xiaomi_sm8635-modules" remote="git-hub" revision="lineage-23.0"/>
	<project path="kernel/xiaomi/sm8635-devicetrees" name="peridot-dev/android_kernel_xiaomi_sm8635-devicetrees" remote="git-hub" revision="lineage-23.0"/>

	<!-- XiaomiDolby -->
	<project path="packages/apps/XiaomiDolby" name="peridot-dev/android_packages_apps_XiaomiDolby" remote="git-hub" revision="lineage-23.0"/>
	
	<!--Dialer with calls recording-->
	<remove-project name="LineageOS/android_packages_apps_Dialer" />
